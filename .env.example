# Copy to .env and adjust values
# .env is gitignored — never commit secrets

# Database (used by docker-compose automatically)
POSTGRES_USER=orbiteus
POSTGRES_PASSWORD=orbiteus
POSTGRES_DB=orbiteus

# Backend
DATABASE_URL=postgresql+asyncpg://orbiteus:orbiteus@localhost:5432/orbiteus
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
ALLOW_PUBLIC_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin1234
# Default tenant created on first startup; the bootstrap admin is bound to
# this tenant so AI BYOK, share-link issue, audit attribution and the rest
# of the multi-tenancy surface work out of the box.
BOOTSTRAP_ADMIN_TENANT_NAME=Orbiteus
BOOTSTRAP_ADMIN_TENANT_SLUG=orbiteus

# Attachment filestore (backend). In Docker these are set in docker-compose.yml
# with a named volume; for bare-metal dev uncomment and use a local path:
# ATTACHMENT_STORAGE=local
# ATTACHMENT_STORAGE_PATH=./data/attachments
# ATTACHMENT_MAX_BYTES=52428800

# Demo dataset (development). Loads Orbiteus HQ, 3 demo users, sample attachments.
# After upgrading from the deprecated bulk seed script, run once with RESET too:
#   SEED_DEMO_DATA=1 RESET_DEMO_DATA=1 docker compose up --build
# SEED_DEMO_DATA=1
# RESET_DEMO_DATA=0

# Frontend (Next.js) — only needed when running outside Docker
# BACKEND_URL=http://localhost:8000

# Optional: AI reranking (leave empty to skip LLM calls)
# ANTHROPIC_API_KEY=sk-ant-...
